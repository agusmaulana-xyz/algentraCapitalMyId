# Salin ke .env.local untuk development.
# Bagian MANUAL diisi operator; bagian OTOMATIS memakai nilai default/installer.
# APP_ENV, HTTP_ADDR, WEB_PORT, DATABASE_FILE, COOKIE_SECURE, WebSocket origins,
# dan endpoint direktori broker ditentukan otomatis dari mode/lokasi/domain.

# ==================== DIISI MANUAL ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

PUBLIC_DOMAIN=
# Token installer sekali pakai: Account Tunnel Read/Edit dan Zone DNS Edit/Zone Read.
CLOUDFLARE_API_TOKEN=

GEMINI_API_KEY=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

PAYMENT_BANK_NAME=
PAYMENT_NUMBER=
PAYMENT_NAME=

AIRPAY_API_KEY=
AIRPAY_MERCHANT_UID=

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=true

# ==================== OTOMATIS / NILAI DEFAULT ====================
# Installer production membuat secret berikut. Untuk development, ganti placeholder
# APP_SECRET_KEY dengan secret acak dan isi API key hanya jika integrasinya dipakai.
APP_SECRET_KEY=
EA_API_KEY=
COPIER_WORKER_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CONTACT_PERSON_NAME=Algentra Capital
CONTACT_WHATSAPP=0852000000
CONTACT_EMAIL=algentracapital@gmail.com
CONTACT_INSTAGRAM=https://www.instagram.com/algentracapital.id/
CONTACT_TELEGRAM=https://t.me/algentra_capital
CONTACT_FACEBOOK=https://www.facebook.com/algentracapital.id/
CONTACT_LINKEDIN=https://www.linkedin.com/algentracapital.id/
