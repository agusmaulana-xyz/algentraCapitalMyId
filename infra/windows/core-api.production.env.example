# Production Core API configuration template. Protect the resulting .env with NTFS ACLs.
# The launcher sets APP_ENV; network, database, cookie, WebSocket, and broker
# production defaults are derived automatically from APP_ENV, PROJECT_ROOT, and PUBLIC_DOMAIN.

# ==================== DIISI MANUAL ====================
PUBLIC_DOMAIN=
# Token installer sekali pakai: Account Tunnel Read/Edit dan Zone DNS Edit/Zone Read.
CLOUDFLARE_API_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
GEMINI_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
AIRPAY_API_KEY=
AIRPAY_MERCHANT_UID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=true

# ==================== OTOMATIS / NILAI DEFAULT ====================
# install.ps1 membuat APP_SECRET_KEY, EA_API_KEY, dan COPIER_WORKER_API_KEY.
APP_SECRET_KEY=
EA_API_KEY=
COPIER_WORKER_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# QRIS AirPay diperiksa otomatis dengan polling status (tanpa konfigurasi webhook).
CONTACT_PERSON_NAME=Algentra Capital
CONTACT_WHATSAPP=0852000000
CONTACT_EMAIL=algentracapital@gmail.com
CONTACT_INSTAGRAM=https://www.instagram.com/algentracapital.id/
CONTACT_TELEGRAM=https://t.me/algentra_capital
CONTACT_FACEBOOK=https://www.facebook.com/algentracapital.id/
CONTACT_LINKEDIN=https://www.linkedin.com/algentracapital.id/
CONTACT_X=https://www.instagram.com/algentracapital.id/
CONTACT_YOUTUBE=https://www.instagram.com/algentracapital.id/
CONTACT_TIKTOK=https://www.tiktok.com/algentracapital.id/
CONTACT_TELEGRAM_ADMIN=https://t.me/algentracapital
CONTACT_WEBSITE=https://algentracapital.my.id
MANAGEMENT_FEE_IDR=150000
